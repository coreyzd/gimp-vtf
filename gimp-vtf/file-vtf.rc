#include <winver.h>

1 ICON "file-vtf.ico"

LANGUAGE 0, 0
1 VERSIONINFO
	FILEVERSION     2,0,0,0
	PRODUCTVERSION  3,0,0,0
	FILETYPE        VFT_APP
	FILESUBTYPE     VFT2_UNKNOWN
	FILEFLAGSMASK   0x00000000
	FILEFLAGS       0x00000000
{
	BLOCK "StringFileInfo"
	{
		BLOCK "08090025"
		{
			VALUE "Comments",         "Adds Valve Texture Format support to GIMP 3"
			VALUE "FileDescription",  "GIMP VTF plug-in"
			VALUE "FileVersion",      "2.0.0"
			VALUE "InternalName",     "file-vtf"
			VALUE "OriginalFilename", "file-vtf.exe"
			VALUE "ProductName",      "GIMP"
			VALUE "ProductVersion",   "3.0"
			VALUE "LegalCopyright",   "LGPL 2.1"
		}
	}
	BLOCK "VarFileInfo"
	{
		VALUE "Translation", 0x0809, 0x0025
	}
}
